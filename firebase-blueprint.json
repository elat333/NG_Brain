{
  "entities": {
    "TeamMember": {
      "title": "Team Member",
      "description": "A member of the team, potentially associated with a user account.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "systemRoleId": { "type": "string" },
        "categories": { "type": "array", "items": { "type": "string" } },
        "processId": { "type": "string" },
        "companyId": { "type": "string" },
        "ruc": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "responsibilities": { "type": "array", "items": { "type": "string" } },
        "recentAchievements": { "type": "array", "items": { "type": "string" } },
        "avatar": { "type": "string" },
        "personality": { "type": "string" },
        "notes": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "epp": { "type": "array", "items": { "type": "string" } },
        "uid": { "type": "string", "description": "Firebase Auth UID if linked" }
      },
      "required": ["id", "name", "role", "categories", "skills", "responsibilities"]
    },
    "Process": {
      "title": "Process",
      "description": "A business process or department.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "goals": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "name", "description", "goals"]
    },
    "Task": {
      "title": "Task",
      "description": "A task assigned to a member within a process.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "storyDescription": { "type": "string" },
        "acceptanceCriteria": { "type": "string" },
        "status": { "type": "string", "enum": ["backlog", "todo", "in_progress", "blocked", "review", "done", "rejected", "correction"] },
        "memberId": { "type": "string" },
        "auxiliaryId": { "type": "string" },
        "auxiliaryIds": { "type": "array", "items": { "type": "string" } },
        "revisorId": { "type": "string" },
        "processId": { "type": "string" },
        "projectId": { "type": "string" },
        "deliverables": { "type": "array", "items": { "$ref": "Deliverable" } },
        "plannedHours": { "type": "number" },
        "actualHours": { "type": "number" },
        "dueDate": { "type": "string" },
        "plannedDate": { "type": "string" },
        "plannedEndDate": { "type": "string" },
        "priority": { "type": "string", "enum": ["baja", "media", "alta", "meteoric_crash"] },
        "blockedByTaskIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "status", "processId", "createdAt"]
    },
    "Deliverable": {
      "title": "Deliverable",
      "description": "A deliverable associated with a task.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "url": { "type": "string" }
      },
      "required": ["id", "label", "url"]
    },
    "Project": {
      "title": "Project",
      "description": "A project involving tasks and processes.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "processId": { "type": "string" },
        "status": { "type": "string", "enum": ["activo", "completado", "pausado"] },
        "city": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "processId", "status", "createdAt"]
    },
    "Company": {
      "title": "Company",
      "description": "An external company (client, provider, etc.)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ruc": { "type": "string" },
        "industry": { "type": "string" },
        "description": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "website": { "type": "string" },
        "address": { "type": "string" },
        "mainAddress": { "type": "string" },
        "branchAddresses": { "type": "array", "items": { "type": "string" } },
        "industries": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "ruc", "createdAt"]
    },
    "Industry": {
      "title": "Industry",
      "description": "An industry or sector categorization.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "createdAt"]
    },
    "Role": {
      "title": "Role",
      "description": "A system role with specific permissions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "description", "permissions", "createdAt"]
    },
    "UserMapping": {
      "title": "User Mapping",
      "description": "A mapping from user email to dynamic member document ID.",
      "type": "object",
      "properties": {
        "memberId": { "type": "string" }
      },
      "required": ["memberId"]
    },
    "ProcessLink": {
      "title": "Process Link",
      "description": "A link of interest for a process.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "processId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "url", "processId", "createdAt"]
    },
    "ProcessNote": {
      "title": "Process Note",
      "description": "A markdown note or document for a process.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "processId": { "type": "string" },
        "createdByMemberId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "content", "processId", "createdByMemberId", "createdAt", "updatedAt"]
    },
    "AcreditationAlly": {
      "title": "Acreditation Ally",
      "description": "Strategic partner or accreditation organization linked to a Company.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "companyId": { "type": "string" },
        "companyName": { "type": "string" },
        "contactId": { "type": "string" },
        "contactName": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contactPhone": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "in_progress", "inactive"] },
        "agreementDate": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "companyId", "companyName", "status", "createdAt"]
    },
    "AcreditationCertification": {
      "title": "Acreditation Certification",
      "description": "Certification or training scheme under OEC, CI, or OC.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "type": { "type": "string", "enum": ["OEC", "CI", "OC"] },
        "allyId": { "type": "string" },
        "allyName": { "type": "string" },
        "companyName": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "price1": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "type", "allyId", "allyName", "purchasePrice", "price1", "status", "createdAt"]
    },
    "PersonalNote": {
      "title": "Personal Markdown Note",
      "description": "Obsidian-like rich markdown note with tags, folders, and sharing permissions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "createdByMemberId": { "type": "string" },
        "createdByName": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "pinned": { "type": "boolean" }
      },
      "required": ["id", "title", "content", "createdByMemberId", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "user_mappings": {
      "schema": "UserMapping",
      "description": "Collection mapping verified emails to member ID."
    },
    "members": {
      "schema": "TeamMember",
      "description": "Collection of team members."
    },
    "processes": {
      "schema": "Process",
      "description": "Collection of business processes."
    },
    "tasks": {
      "schema": "Task",
      "description": "Collection of tasks."
    },
    "projects": {
      "schema": "Project",
      "description": "Collection of projects."
    },
    "companies": {
      "schema": "Company",
      "description": "Collection of companies."
    },
    "industries": {
      "schema": "Industry",
      "description": "Collection of industries."
    },
    "roles": {
      "schema": "Role",
      "description": "Collection of system roles."
    },
    "process_links": {
      "schema": "ProcessLink",
      "description": "Collection of links of interest per process."
    },
    "user_personal_links": {
      "schema": "ProcessLink",
      "description": "Collection of personal links of interest per member/user."
    },
    "user_personal_notes": {
      "schema": "PersonalNote",
      "description": "Collection of Obsidian markdown notes per member/user."
    },
    "process_notes": {
      "schema": "ProcessNote",
      "description": "Collection of markdown notes per process."
    },
    "acreditation_allies": {
      "schema": "AcreditationAlly",
      "description": "Collection of strategic certification partners and allies."
    },
    "acreditation_certifications": {
      "schema": "AcreditationCertification",
      "description": "Collection of accredited courses and certifications."
    },
    "products": {
      "schema": "ProductItem",
      "description": "Collection of commercial product catalog items and services."
    }
  }
}
