rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Check if the user has the 'role-admin' system role
    function isAdmin() {
      let member = getMember();
      return isSignedIn() && member != null && ('systemRoleId' in member) && member.systemRoleId == 'role-admin';
    }
    
    // Note: Sofia Chen's UID should be added to an 'admins' collection for bootstrap
    // or we assume the first user who sets up their profile is an admin.
    // For this app, I'll allow the user from metadata to be an admin if they sign in.
    function isSuperAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email.lower() == 'e.siavichay@novagreen.ec') || 
        isAdmin()
      );
    }

    function getMemberId() {
      let email = 'email' in request.auth.token ? request.auth.token.email.lower() : '';
      let mappingPath = /databases/$(database)/documents/user_mappings/$(email);
      let existsMapping = email != '' && exists(mappingPath);
      return existsMapping ? get(mappingPath).data.memberId : null;
    }

    function getMember() {
      let directMemberPath = /databases/$(database)/documents/members/$(request.auth.uid);
      let memberId = getMemberId();
      let mappedMemberPath = memberId != null ? /databases/$(database)/documents/members/$(memberId) : null;
      return exists(directMemberPath) ? get(directMemberPath).data : (
        mappedMemberPath != null && exists(mappedMemberPath) ? get(mappedMemberPath).data : null
      );
    }

    // Check if the user is a leader for the process of the task
    function isProcessLeader(processId) {
      let member = getMember();
      let hasMember = member != null;
      let moduleAccess = hasMember && 'moduleAccess' in member && member.moduleAccess != null ? member.moduleAccess : {};
      let systemRoleId = hasMember && 'systemRoleId' in member ? member.systemRoleId : '';
      let memberRole = hasMember && 'role' in member && member.role is string ? member.role : '';
      let memberProcessId = hasMember && 'processId' in member && member.processId is string ? member.processId : '';
      let isSystemAdmin = hasMember && 'isSystemAdmin' in member ? member.isSystemAdmin : false;
      
      let pId = processId is string ? processId : '';
      let specificKey = 'tasks_' + pId;
      let specificAccess = specificKey in moduleAccess ? moduleAccess[specificKey] : null;
      let generalAccess = 'tasks' in moduleAccess ? moduleAccess['tasks'] : null;
      let marketingAccess = 'marketing' in moduleAccess ? moduleAccess['marketing'] : null;
      let acreditacionAccess = 'acreditacion' in moduleAccess ? moduleAccess['acreditacion'] : null;
      
      let isMktProcess = pId == 'proc-mkt' || (pId.size() > 0 && pId.matches('.*mkt.*'));
      let isAcredProcess = pId == 'proc-acred' || pId == 'acreditacion' || (pId.size() > 0 && pId.matches('.*acred.*'));
      let isAcredMember = memberProcessId == 'proc-acred' || memberProcessId == 'acreditacion' || (memberProcessId.size() > 0 && memberProcessId.matches('.*acred.*'));

      return isSignedIn() && hasMember && (
        isSystemAdmin == true ||
        systemRoleId == 'role-admin' ||
        specificAccess == 'lider' ||
        specificAccess == 'administrador' ||
        (isMktProcess && (marketingAccess == 'lider' || marketingAccess == 'administrador')) ||
        (isAcredProcess && (acreditacionAccess == 'lider' || acreditacionAccess == 'administrador')) ||
        (pId.size() > 0 && (memberProcessId == pId || (isAcredMember && isAcredProcess)) && (systemRoleId == 'role-lider' || memberRole.matches('.*(Lider|Líder|lider|líder).*'))) ||
        (
          (specificAccess == null || specificAccess == 'ninguno') && (
            generalAccess == 'lider' ||
            generalAccess == 'administrador' ||
            acreditacionAccess == 'lider' ||
            acreditacionAccess == 'administrador' ||
            marketingAccess == 'lider' ||
            marketingAccess == 'administrador'
          )
        )
      );
    }

    // Check if the user is a collaborator for the process of the task
    function isProcessCollaborator(processId) {
      let member = getMember();
      let hasMember = member != null;
      let moduleAccess = hasMember && 'moduleAccess' in member && member.moduleAccess != null ? member.moduleAccess : {};
      let memberProcessId = hasMember && 'processId' in member && member.processId is string ? member.processId : '';
      
      let pId = processId is string ? processId : '';
      let specificKey = 'tasks_' + pId;
      let specificAccess = specificKey in moduleAccess ? moduleAccess[specificKey] : null;
      let generalAccess = 'tasks' in moduleAccess ? moduleAccess['tasks'] : null;
      let marketingAccess = 'marketing' in moduleAccess ? moduleAccess['marketing'] : null;
      let acreditacionAccess = 'acreditacion' in moduleAccess ? moduleAccess['acreditacion'] : null;

      let isMktProcess = pId == 'proc-mkt' || (pId.size() > 0 && pId.matches('.*mkt.*'));
      let isAcredProcess = pId == 'proc-acred' || pId == 'acreditacion' || (pId.size() > 0 && pId.matches('.*acred.*'));
      let isAcredMember = memberProcessId == 'proc-acred' || memberProcessId == 'acreditacion' || (memberProcessId.size() > 0 && memberProcessId.matches('.*acred.*'));
      
      return isSignedIn() && hasMember && (
        specificAccess == 'colaborador' ||
        (isMktProcess && (marketingAccess == 'colaborador')) ||
        (isAcredProcess && (acreditacionAccess == 'colaborador')) ||
        (pId.size() > 0 && (memberProcessId == pId || (isAcredMember && isAcredProcess))) ||
        ((specificAccess == null || specificAccess == 'ninguno') && generalAccess == 'colaborador')
      );
    }

    // Check if the user is a leader for the process of the project
    function isProjectLeader(processId) {
      let member = getMember();
      let hasMember = member != null;
      let moduleAccess = hasMember && 'moduleAccess' in member && member.moduleAccess != null ? member.moduleAccess : {};
      let systemRoleId = hasMember && 'systemRoleId' in member ? member.systemRoleId : '';
      let isSystemAdmin = hasMember && 'isSystemAdmin' in member ? member.isSystemAdmin : false;
      
      let specificKey = 'projects_' + processId;
      let specificAccess = specificKey in moduleAccess ? moduleAccess[specificKey] : null;
      let marketingAccess = 'marketing' in moduleAccess ? moduleAccess['marketing'] : null;
      
      return isSignedIn() && hasMember && (
        isSystemAdmin == true ||
        systemRoleId == 'role-admin' ||
        specificAccess == 'lider' ||
        specificAccess == 'administrador' ||
        (processId == 'proc-mkt' && (marketingAccess == 'lider' || marketingAccess == 'administrador' || marketingAccess == 'colaborador')) ||
        (specificAccess == null && ('projects' in moduleAccess && (moduleAccess['projects'] == 'lider' || moduleAccess['projects'] == 'administrador')))
      );
    }

    // Check if the user is an administrator for the process of the project
    function isProjectAdmin(processId) {
      let member = getMember();
      let hasMember = member != null;
      let moduleAccess = hasMember && 'moduleAccess' in member && member.moduleAccess != null ? member.moduleAccess : {};
      let systemRoleId = hasMember && 'systemRoleId' in member ? member.systemRoleId : '';
      let isSystemAdmin = hasMember && 'isSystemAdmin' in member ? member.isSystemAdmin : false;
      
      let specificKey = 'projects_' + processId;
      let specificAccess = specificKey in moduleAccess ? moduleAccess[specificKey] : null;
      
      return isSignedIn() && hasMember && (
        isSystemAdmin == true ||
        systemRoleId == 'role-admin' ||
        specificAccess == 'administrador'
      );
    }

    // Check if the user is the direct primary or auxiliary assignee (responsible) of the task
    function isTaskAssignee(taskData) {
      let member = getMember();
      let memberId = member != null && 'id' in member ? member.id : '';
      let taskMemberId = 'memberId' in taskData ? taskData.memberId : '';
      let taskAuxId = 'auxiliaryId' in taskData ? taskData.auxiliaryId : '';
      let taskAuxIds = 'auxiliaryIds' in taskData && taskData.auxiliaryIds is list ? taskData.auxiliaryIds : [];
      return memberId != '' && (taskMemberId == memberId || taskAuxId == memberId || memberId in taskAuxIds);
    }

    // --- Collections ---

    match /user_mappings/{email} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isSuperAdmin() || request.auth.token.email.lower() == email.lower());
      allow delete: if isSuperAdmin();
    }

    match /members/{memberId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidMember(incoming()) && (isSuperAdmin() || incoming().uid == request.auth.uid);
      allow update: if isSignedIn() && isValidMember(incoming()) && (
        isSuperAdmin() || 
        (incoming().uid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatar', 'personality', 'notes', 'email', 'phone']))
      );
      allow delete: if isSuperAdmin();
    }

    function isValidMember(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.role is string && data.role.size() <= 100 &&
             data.categories is list && data.categories.size() <= 10;
    }

    match /processes/{processId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidTask(incoming()) && (!('processId' in incoming()) || incoming().processId == '' || incoming().processId == 'proc-mkt' || exists(/databases/$(database)/documents/processes/$(incoming().processId)));
      allow update: if isSignedIn() && isValidTask(incoming()) && (
        isSuperAdmin() || 
        isProcessLeader('processId' in existing() ? existing().processId : '') ||
        incoming().diff(existing()).affectedKeys().hasOnly(['comments']) ||
        (
          (isTaskAssignee(existing()) || isProcessCollaborator('processId' in existing() ? existing().processId : '')) && 
          incoming().diff(existing()).affectedKeys().hasOnly([
            'deliverables', 'actualHours', 'plannedHours', 'dueDate', 'plannedDate', 'plannedEndDate', 'history', 'status',
            'actualStartDate', 'actualEndDate', 'actualStartTime', 'actualEndTime',
            'plannedStartTime', 'plannedEndTime', 'comments', 'designData'
          ]) && (
            incoming().status == existing().status ||
            incoming().status in ['todo', 'in_progress', 'review', 'correction', 'done', 'blocked']
          )
        )
      );
      allow delete: if isSuperAdmin() || isProcessLeader('processId' in existing() ? existing().processId : '');
    }

    function isValidTask(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.status in ['backlog', 'todo', 'in_progress', 'blocked', 'review', 'done', 'rejected', 'correction'] &&
             (!('processId' in data) || data.processId == '' || (data.processId is string && isValidId(data.processId)));
    }

    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isSuperAdmin() || isProjectLeader(incoming().processId));
      allow update: if isSignedIn() && (
        isSuperAdmin() || 
        (isProjectLeader('processId' in existing() ? existing().processId : '') && isProjectLeader(incoming().processId))
      );
      allow delete: if isSuperAdmin() || isProjectAdmin('processId' in existing() ? existing().processId : '');
    }

    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /industries/{industryId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /process_links/{linkId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /user_personal_links/{linkId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /user_personal_links_prefs/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /user_personal_notes/{noteId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /user_personal_notes_prefs/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /process_notes/{noteId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /management_notes/{noteId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /management_strategy/{stratId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /management_governance/{govId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /importation_products/{prodId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /importation_suppliers/{supId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /importation_proformas/{profId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /marketing_campaigns/{id} {
      allow read, write: if isSignedIn();
    }
    match /marketing_contents/{id} {
      allow read, write: if isSignedIn();
    }
    match /marketing_leads/{id} {
      allow read, write: if isSignedIn();
    }
    match /marketing_metrics/{id} {
      allow read, write: if isSignedIn();
    }
    match /trainers/{id} {
      allow read, write: if isSignedIn();
    }
    match /training_spaces/{id} {
      allow read, write: if isSignedIn();
    }
    match /training_plans/{id} {
      allow read, write: if isSignedIn();
    }
    match /training_managements/{id} {
      allow read, write: if isSignedIn();
    }
    match /sales_clients/{id} {
      allow read, write: if isSignedIn();
    }
    match /sales_deals/{id} {
      allow read, write: if isSignedIn();
    }
    match /sales_quotes/{id} {
      allow read, write: if isSignedIn();
    }
    match /acreditation_allies/{id} {
      allow read, write: if isSignedIn();
    }
    match /acreditation_certifications/{id} {
      allow read, write: if isSignedIn();
    }
    match /products/{id} {
      allow read, write: if isSignedIn();
    }
  }
}
